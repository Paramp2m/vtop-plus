{
  "manifest_version": 3,
  "name": "VTOP Plus",
  "version": "1.0.0",
  "description": "Unofficial quality-of-life improvements for VIT's VTOP student portal: captcha auto-fill, quick-nav buttons, attendance and marks helpers, assignment due dates. A Firefox port of ViBoot.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vtop-plus@param-hypr",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "*://vtop.vit.ac.in/*"
  ],
  "background": {
    "scripts": [
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "lib/ns.js",
        "lib/vtop-request.js",
        "lib/attendance-math.js",
        "lib/marks-math.js",
        "lib/dates.js",
        "lib/da-dues.js",
        "content/screens.js",
        "content/router.js",
        "content/features/navbar.js",
        "content/features/attendance.js",
        "content/features/marks.js",
        "content/features/da-list.js",
        "content/features/da-sort.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content/viboot.css"
      ]
    },
    {
      "matches": [
        "*://vtop.vit.ac.in/vtop/login*",
        "*://vtop.vit.ac.in/vtop/prelogin/*"
      ],
      "js": [
        "lib/ns.js",
        "lib/captcha-solve.js",
        "content/captcha/model.js",
        "content/features/captcha.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
